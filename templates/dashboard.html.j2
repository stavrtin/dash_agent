<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Итоги недели с {{ report.meta.period_start | dmy }} по {{ report.meta.period_end | dmy }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<style>
  * { margin:0; padding:0; box-sizing:border-box;
      font-family:'Segoe UI','Inter',system-ui,sans-serif; }
  body { background:#f5f8fc; padding:24px; color:#1e2b3c; }
  .dashboard { max-width:1400px; margin:0 auto; }

  /* ---------- header ---------- */
  .header { display:flex; flex-wrap:wrap; justify-content:space-between;
            align-items:center; margin-bottom:28px; gap:16px; }
  .header h1 { font-size:2.2rem; font-weight:600; letter-spacing:-.5px;
    background:linear-gradient(145deg,#0a3d62,#1e5a7a);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    background-clip:text; display:flex; align-items:center; gap:12px; }
  .header h1 i { background:none; -webkit-text-fill-color:#1e5a7a; font-size:2rem; }
  .date-badge { background:#fff; padding:10px 22px; border-radius:60px;
    box-shadow:0 8px 20px rgba(0,20,40,.06); font-weight:500; font-size:1.1rem;
    color:#0a3d62; display:flex; align-items:center; gap:10px;
    border:1px solid #d9e6f2; }
  .date-badge i { color:#2e7da6; }

  /* ---------- сетка карточек ---------- */
  .grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));
    gap:20px; margin-bottom:20px; align-items:start; }

  .card { background:#fff; border-radius:24px; padding:20px;
    box-shadow:0 8px 24px rgba(0,30,60,.05);
    transition:transform .15s ease, box-shadow .2s;
    border:1px solid #e3eef9; display:flex; flex-direction:column; }
  .card:hover { box-shadow:0 16px 32px rgba(0,40,80,.1); transform:translateY(-2px); }

  .card-header { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
  .card-header i { font-size:1.9rem; width:2.4rem; text-align:center; color:#1e5a7a; }
  .card-header h2 { font-size:1.15rem; font-weight:600; color:#0e3f5e;
    letter-spacing:-.2px; line-height:1.3; }

  .card-content { font-size:.97rem; line-height:1.5; color:#1f3a4b; flex:1; }

  /* ---------- метрики ---------- */
  .stat-row { display:flex; align-items:baseline; gap:8px; margin-bottom:8px; flex-wrap:wrap; }
  .stat-number { font-size:1.8rem; font-weight:700; color:#0a3d62; line-height:1.1; }
  .stat-label { font-size:.9rem; color:#5b7c93; font-weight:500; }
  .metric-sub { font-size:.9rem; color:#3d5775; margin-bottom:6px; }

  .metric-list { list-style:none; padding:0; margin:0 0 10px; }
  .metric-list li { display:flex; align-items:baseline; gap:8px; margin-bottom:6px; }
  .metric-list li .stat-number { font-size:1.4rem; }
  .metric-list li .stat-label { font-size:.88rem; }

  /* ---------- бейджи ---------- */
  .badge { display:inline-block; background:#e8f2fa; padding:4px 12px;
    border-radius:40px; font-size:.8rem; font-weight:600; color:#1e5a7a;
    margin-right:6px; margin-bottom:6px; white-space:nowrap; }
  .badge-red    { background:#ffeaea; color:#b13e3e; }
  .badge-yellow { background:#fff4db; color:#a7691a; }
  .badge-green  { background:#e4f5e9; color:#1e7a4a; }
  .badge-orange { background:#fff0e0; color:#c0721e; }
  .badge-purple { background:#f0e8fa; color:#6f4f9e; }
  .badge-blue   { background:#e8f2fa; color:#1a5c9e; }

  /* ---------- акценты ---------- */
  .highlight { background:#f0f7ff; border-left:4px solid #2e7da6;
    padding:10px 14px; border-radius:12px; margin:10px 0 0; font-size:.92rem; }
  .divider { height:1px; background:#d9e6f2; margin:14px 0; }

  /* ---------- блоки внутри карточки ---------- */
  .block { margin-bottom:14px; }
  .block:last-child { margin-bottom:0; }
  .block h4 { font-size:.95rem; font-weight:600; color:#1a5c9e;
    margin-bottom:6px; text-transform:uppercase; letter-spacing:.3px; }
  .block p, .block li { font-size:.95rem; line-height:1.55; color:#1f2e44; }
  .block ul { list-style:none; padding:0; }
  .block ul li { position:relative; padding-left:18px; margin-bottom:5px; }
  .block ul li::before { content:"•"; position:absolute; left:0; top:0;
    color:#2e7da6; font-weight:700; }

  .list-item { display:flex; gap:8px; margin-bottom:8px; align-items:flex-start; }
  .list-item i { color:#2e7da6; font-size:.8rem; margin-top:5px; width:14px; }

  /* ---------- СМИ ---------- */
  .media-section { background:#fff; border-radius:28px; padding:20px 24px;
    margin-top:28px; border:1px solid #e3eef9;
    box-shadow:0 8px 24px rgba(0,30,60,.04); }
  .media-header { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
  .media-header i { font-size:1.8rem; color:#1e5a7a; }
  .media-header h3 { font-size:1.4rem; font-weight:600; color:#0e3f5e; }

  .media-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));
    gap:18px; align-items:start; }
  .media-block { background:#f9fcff; border-radius:18px; padding:16px 18px;
    border-left:6px solid #2e7da6; }
  .media-block.red    { border-left-color:#c0392b; }
  .media-block.yellow { border-left-color:#e6a017; }
  .media-block.green  { border-left-color:#2e8b57; }

  .media-title { font-weight:700; margin-bottom:12px; font-size:1.05rem;
    display:flex; align-items:center; gap:8px; }
  .media-item { margin-bottom:12px; padding-bottom:10px;
    border-bottom:1px dashed #d4e2ed; }
  .media-item:last-child { border-bottom:none; margin-bottom:0; padding-bottom:0; }
  .media-item a { color:#1e5a7a; text-decoration:none; font-weight:500;
    word-break:break-word; font-size:.85rem; }
  .media-item a:hover { text-decoration:underline; }
  .media-desc { font-size:.9rem; margin:4px 0 2px; color:#1e2b3c; }
  .media-react { font-size:.85rem; color:#3c5a6f; background:#eef4fa;
    padding:6px 10px; border-radius:12px; margin-top:6px; }
  .small-icon { font-size:.8rem; margin-right:4px; color:#5b7c93; }

  /* ---------- footer ---------- */
  .footer-note { text-align:right; margin-top:24px; font-size:.8rem; color:#7f9bb0; }

  /* ---------- адаптив ---------- */
  @media (max-width:600px) {
    body { padding:14px; }
    .header h1 { font-size:1.6rem; }
    .stat-number { font-size:1.5rem; }
    .media-section { padding:16px; }
  }
</style>
</head>
<body>
<div class="dashboard">

  {# ---------- ЗАГОЛОВОК ---------- #}
  <div class="header">
    <h1><i class="fas fa-leaf"></i> Итоги недели с {{ report.meta.period_start | dmy }} по {{ report.meta.period_end | dmy }}</h1>
    {% if report.meta.period_start and report.meta.period_end %}
<div class="date-badge">
  <i class="fas fa-calendar-alt"></i>
  {{ report.meta.period_start | dmy }} – {{ report.meta.period_end | dmy }}
</div>
    {% endif %}
  </div>

  {# ---------- ОСНОВНЫЕ КАРТОЧКИ (по секциям) ---------- #}
  <div class="grid">
    {% for s in report.sections %}
      {% if s.blocks %}
      <div class="card" id="{{ s.id }}">
        <div class="card-header">
          <i class="{{ s.icon | fa_class }}"></i>
          <h2>{{ s.title }}</h2>
        </div>
        <div class="card-content">

          {# Метрики, привязанные к этой секции по anchor #}
          {% set section_metrics = report.metrics | selectattr('anchor', 'equalto', '#' ~ s.id) | list %}
          {% if section_metrics %}
            {% if section_metrics | length == 1 %}
              {% set m = section_metrics[0] %}
              <div class="stat-row">
                <span class="stat-number">{{ m.value }}</span>
                {% if m.unit %}<span class="stat-label">{{ m.unit }}</span>{% endif %}
              </div>
              {% if m.sub %}<div class="metric-sub">{{ m.sub }}</div>{% endif %}
            {% else %}
              <ul class="metric-list">
                {% for m in section_metrics %}
                  <li>
                    <span class="stat-number">{{ m.value }}</span>
                    <span class="stat-label">{{ m.label }}{{ m.unit | unit_label }}</span>
                  </li>
                {% endfor %}
              </ul>
              {% if section_metrics[0].sub %}
                <div class="metric-sub">{{ section_metrics[0].sub }}</div>
              {% endif %}
            {% endif %}
          {% endif %}

          {# Блоки внутри секции #}
          {% for b in s.blocks %}
            {% include "partials/block.html.j2" with context %}
          {% endfor %}

        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>

  {# ---------- СМИ ---------- #}
  {% if report.smi and report.smi.groups %}
  <div class="media-section" id="section-smi">
    <div class="media-header">
      <i class="fas fa-newspaper"></i>
      <h3>СМИ · Дайджест
        {% if report.smi.digest_period %}({{ report.smi.digest_period }}){% endif %}
      </h3>
    </div>
    <div class="media-grid">
      {% for g in report.smi.groups %}
        <div class="media-block {{ g.criticality }}">
          <div class="media-title">
            {% if g.criticality == 'high' %}
              <i class="fas fa-exclamation-circle" style="color:#c0392b;"></i>
            {% elif g.criticality == 'medium' %}
              <i class="fas fa-exclamation-triangle" style="color:#e6a017;"></i>
            {% else %}
              <i class="fas fa-check-circle" style="color:#2e8b57;"></i>
            {% endif %}
            {{ g.label }}
          </div>
          {% for c in g.cards %}
            <div class="media-item">
              <div><i class="fas fa-circle small-icon"></i> <strong>{{ c.title }}</strong></div>

                  {% set clean_desc = c.desc | strip_link %}
                  {% if clean_desc %}
                    <div class="media-desc">{{ clean_desc }}</div>
                  {% endif %}

                  {% if c.link %}
                    <a href="{{ c.link }}" target="_blank">{{ c.link }}</a>
                  {% endif %}

                  {% if c.reaction %}
                    <div class="media-react"><strong>Реагирование:</strong> {{ c.reaction }}</div>
                  {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="footer-note">
    <i class="fas fa-database"></i>
    Данные: справка ДПиООС · {{ report.meta.period_start }} – {{ report.meta.period_end }}
  </div>

</div>
</body>
</html>